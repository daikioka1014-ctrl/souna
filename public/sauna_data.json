<script>
const RK=[...D].filter(x=>!x.u).sort((a,b)=>a.r-b.r),ix=x=>D.indexOf(x);
function feat(){const[a,b,c]=RK,sh=x=>[x.s,x.a!=="未設定"?x.a:""].filter(Boolean).join("・"),sm=x=>`<button class="card" data-open data-i="${ix(x)}"><div class="ph" style="background:${bg(x.c)}">${pic(x)}</div><div class="info"><span class="tag">${topAx(x)}</span><h3>${x.n}</h3><p>${sh(x)}</p><div class="score">${x.tot}<small>/100</small></div></div></button>`;
$("feat").innerHTML=`<p class="eyebrow">FEATURE</p><div class="fg"><button class="card feat1" data-open data-i="${ix(a)}"><div class="ph" style="background:${bg(a.c)}">${pic(a)}</div><div class="info"><span class="tag">総合1位・${topAx(a)}</span><h2>${a.n}</h2><p>${sh(a)}</p>${a.m?`<p class="lc">${a.m.split("。")[0]}。</p>`:""}<div class="score">${a.tot}<small>/100</small></div></div></button><div class="fs">${sm(b)}${sm(c)}</div></div>`}
function side(){const cnt={};D.forEach(x=>{if(x.a!=="未設定")cnt[x.a]=(cnt[x.a]||0)+1});
$("side").innerHTML=`<h2>ランキング TOP5</h2><ol>${RK.slice(0,5).map((x,i)=>`<li><span class="rn">${i<3?crown(i+1):i+1}</span><a href="#" data-open data-i="${ix(x)}">${x.n}</a><b>${x.tot}</b></li>`).join("")}</ol><h2>エリアで探す</h2><div class="tg">${Object.keys(cnt).sort((p,q)=>cnt[q]-cnt[p]).map(a=>`<button data-a="${a}">${a} <span>${cnt[a]}</span></button>`).join("")}</div><div class="cta"><h2>あなたの好み診断</h2><p>好きなソフトを3つ選ぶと、次に食べたい一杯が見つかります。</p><button data-go="quiz">診断してみる</button></div>`}
$("side").addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;if(b.dataset.a){area=b.dataset.a;bar();grid();$("bar").scrollIntoView({behavior:"smooth"})}if(b.dataset.go)document.querySelector('#tabs [data-tab="quiz"]').click()});
$("more").onclick=()=>{lim+=vw==="l"?20:24;grid()};
document.addEventListener("keydown",e=>{if(e.key==="Enter"&&e.target.matches&&e.target.matches("tr[data-open]"))e.target.click()});
feat();side();
</script>
<script>
(function(){const S=RK.slice(0,5),sh=x=>[x.s,x.a!=="未設定"?x.a:""].filter(Boolean).join("・"),rm=matchMedia("(prefers-reduced-motion:reduce)").matches;
$("feat").innerHTML=`<div class="sl" role="region" aria-roledescription="carousel" aria-label="注目のソフトクリーム">${S.map((x,i)=>`<button class="slide${i?"":" on"}" data-open data-i="${ix(x)}" aria-label="${x.n}の詳細" style="background:${bg(x.c)}">${pic(x)}<span class="shade"></span><span class="cap"><em>${i<3?crown(i+1):""}No.${i+1}</em><b>${x.n}</b><i>${sh(x)}</i><u>${x.tot}<small>/100</small></u></span></button>`).join("")}<button class="nv p" aria-label="前へ">‹</button><button class="nv n" aria-label="次へ">›</button><div class="dots">${S.map((_,i)=>`<button aria-label="${i+1}枚目" aria-current="${!i}"></button>`).join("")}</div></div>`;
let c=0,t;const sl=$("feat").querySelector(".sl"),ss=[...sl.querySelectorAll(".slide")],ds=[...sl.querySelectorAll(".dots button")];
const go=n=>{c=(n+ss.length)%ss.length;ss.forEach((e,i)=>e.classList.toggle("on",i===c));ds.forEach((d,i)=>d.setAttribute("aria-current",i===c))},play=()=>{clearInterval(t);if(!rm)t=setInterval(()=>go(c+1),5500)};
sl.querySelector(".p").onclick=()=>{go(c-1);play()};sl.querySelector(".n").onclick=()=>{go(c+1);play()};ds.forEach((d,i)=>d.onclick=()=>{go(i);play()});
sl.addEventListener("mouseenter",()=>clearInterval(t));sl.addEventListener("mouseleave",play);sl.addEventListener("focusin",()=>clearInterval(t));let x0=null,sw=false;sl.addEventListener("touchstart",e=>{x0=e.touches[0].clientX;sw=false;clearInterval(t)},{passive:true});sl.addEventListener("touchend",e=>{if(x0===null)return;const dx=e.changedTouches[0].clientX-x0;x0=null;if(Math.abs(dx)>40){sw=true;go(c+(dx<0?1:-1))}play()});sl.addEventListener("click",e=>{if(sw){e.stopPropagation();e.preventDefault();sw=false}},true);$("rubricd").open=matchMedia("(min-width:641px)").matches;play();
const ob="IntersectionObserver"in window&&!rm?new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");ob.unobserve(e.target)}}),{rootMargin:"0px 0px -6% 0px"}):null;
function reveal(){if(!ob)return;document.querySelectorAll("#grid .card:not(.rv),#side>*:not(.rv)").forEach((el,i)=>{el.classList.add("rv");el.style.transitionDelay=(i%6)*70+"ms";el.addEventListener("transitionend",()=>{el.style.transitionDelay=""},{once:true});ob.observe(el)})}
const g0=grid;grid=function(){g0();reveal()};reveal();
})();
