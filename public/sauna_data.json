const un=t=>t.replace(/&amp;/g,"&"),H=new Map();
D.forEach((x,i)=>{const g=GEO.find(g=>x.s.includes(g[0]));if(!g)return;if(!H.has(x.s))H.set(x.s,{s:x.s,lat:g[1],lng:g[2],items:[]});H.get(x.s).items.push(i)});
const seen={};H.forEach(h=>{const k=h.lat+","+h.lng,n=seen[k]=(seen[k]||0)+1;if(n>1){const a=n*2.399,r=.0045*Math.sqrt(n);h.lat+=r*Math.sin(a);h.lng+=r*Math.cos(a)}});
const unmapped=D.filter(x=>![...H.values()].some(h=>h.s===x.s)).length;$("mcount").textContent=` 位置を設定できなかった記録：${unmapped}件`;
