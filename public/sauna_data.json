const ZR=D.filter(x=>!x.u),ZAV=AX.map((_,i)=>ZR.reduce((s,x)=>s+x.t[i],0)/ZR.length),zk=x=>D.indexOf(x);
const ZTY=[["王道の美味しさ派","まずは味。素直においしい一杯に高い点をつけるタイプです。"],["フォルム重視の美学派","見た目と、ソフトクリームとしての形の美しさを大切にするタイプです。"],["調和を愛するバランス派","ミルクとの調和が取れた、まとまりのある一杯を好むタイプです。"],["素材探求派","原材料の味や香りがしっかり感じられる一杯を求めるタイプです。"],["珍味に挑む冒険派","珍しい素材や挑戦的な一杯に、わくわくするタイプです。"]];
let zp=[],zQ="";
function zlist(){const L=ZR.filter(x=>!zQ||(x.n+x.s).toLowerCase().includes(zQ)).sort((a,b)=>has("eat",b)-has("eat",a)||b.tot-a.tot).slice(0,60);
