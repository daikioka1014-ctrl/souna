<script>
(function(){
const Q=[
{q:"ソフトクリームを選ぶとき、いちばん大切にしたいのは？",o:[["濃厚でコクのある、しっかりした味",4],["すっきりして食べやすい味わい",1],["味よりも、食べて楽しいかどうか",-1]]},
{q:"目の前に出てきた瞬間、まず気になるのは？",o:[["巻きの美しさなど、ソフトクリーム全体のフォルム",4],["色や盛りつけの、かわいさ・映え",3],["見た目は気にしない。味がよければOK",-3]]},
{q:"ミルクとフレーバーの関係は、どうあってほしい？",o:[["溶け合って、ひとつにまとまった味",4],["ミルクの味を、しっかり感じられる",1],["フレーバーが主役。個性がぶつかってもOK",-2]]},
{q:"素材（原材料）の味や香りは、どのくらい感じたい？",o:[["はっきり、素材そのものの味と香りを",4],["ほんのり香る程度の、上品さ",1],["素材よりも、なめらかさや甘さを重視",-3]]},
{q:"旅先で出会うなら、どんなソフトクリーム？",o:[["野菜や海産物など、驚きのある変わり種",5],["定番の中に、ちょっとした工夫があるもの",1],["バニラやミルクなどの王道",-3]]}];
let qi=0,qa=[],cm="q";const box=$("zqs");
function qshow(){const c=Q[qi];box.hidden=false;box.innerHTML=`<p class="zhint">質問 ${qi+1} / ${Q.length}</p><div class="zbar"><i style="width:${qi/Q.length*100}%"></i></div><h2>${c.q}</h2><div class="zopts">${c.o.map((o,j)=>`<button class="zopt" data-j="${j}">${o[0]}</button>`).join("")}</div>${qi?'<button class="zback">← 前の質問に戻る</button>':""}`}
box.addEventListener("click",e=>{const o=e.target.closest(".zopt"),bk=e.target.closest(".zback");if(o){qa[qi]=Q[qi].o[+o.dataset.j][1];qi++;if(qi<Q.length)qshow();else{box.hidden=true;window.zT=Math.max(...qa)<=1?["気軽に楽しむ定番派","肩ひじ張らず、気軽に楽しめる一杯を好むタイプです。"]:null;zshow(AX.map((_,i)=>Math.max(2,Math.min(20,ZAV[i]+qa[i]))))}}else if(bk){qi--;qshow()}});
function mode(m){cm=m;window.zT=null;$("zsel").hidden=m!=="s";$("zres").hidden=true;if(m==="q"){qi=0;qa=[];qshow()}else box.hidden=true;document.querySelectorAll(".zmode button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.m===m))}
document.querySelector(".zmode").addEventListener("click",e=>{const b=e.target.closest("button");if(b)mode(b.dataset.m)});
$("zres").addEventListener("click",e=>{if(e.target.closest("#zagain"))mode(cm)});
mode("q");
})();
</script>
