.mk{position:absolute;right:10px;top:8px;font-size:12px;font-weight:900;background:var(--ink);color:var(--bg);border-radius:99px;padding:0 10px}.mk.w{background:var(--accent);color:#1b2a41}
.prog{align-self:center;font-size:13px;color:var(--sub);flex:none;white-space:nowrap;margin-left:6px}.empty{grid-column:1/-1;color:var(--sub);text-align:center;padding:30px 0}
.bar .cols{display:none}
@media (max-width:640px){.bar .cols{display:flex}.wrap{padding:20px 12px 56px}.grid{grid-template-columns:repeat(var(--c,4),1fr);gap:8px}.card{border-radius:12px}.info{padding:6px 6px 8px}.info h3{font-size:10.5px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.info p{display:none}.score{font-size:17px;margin-top:4px}.score small{display:none}.rank{font-size:10px;left:4px;top:4px;padding:0 6px}.mk{right:4px;top:4px;font-size:10px;padding:0 6px}.ph svg{width:66%}.grid[data-c="2"] .info{padding:10px 12px 12px}.grid[data-c="2"] .info h3{font-size:13px}.grid[data-c="2"] .info p{display:block;font-size:11px}.grid[data-c="2"] .score{font-size:26px}.grid[data-c="2"] .score small{display:inline}.grid[data-c="3"] .info h3{font-size:11.5px}.grid[data-c="3"] .score{font-size:22px}}
