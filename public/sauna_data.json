function zradar(U){const c=100,r=70,P2=(i,v)=>{const g=-Math.PI/2+i*2*Math.PI/5;return[c+r*v/20*Math.cos(g),c+r*v/20*Math.sin(g)]};
const pl=(a,st)=>`<polygon points="${a.map((v,i)=>P2(i,v).join(",")).join(" ")}" ${st}/>`;
let g="";[5,10,15,20].forEach(l=>g+=pl([l,l,l,l,l],'fill="none" stroke="var(--line)"'));
const lb=AX.map((a,i)=>{const g2=-Math.PI/2+i*2*Math.PI/5;return`<text x="${c+(r+17)*Math.cos(g2)}" y="${c+(r+17)*Math.sin(g2)+4}" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--ink)">${a}</text>`}).join("");
return`<svg viewBox="0 0 200 200" role="img" aria-label="好みのレーダーチャート">${g}${pl(ZAV,'fill="none" stroke="var(--sub)" stroke-width="2" stroke-dasharray="4 3"')}${pl(U,'fill="var(--accent)" fill-opacity=".3" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round"')}${lb}</svg>`}
function zrun(){zshow(AX.map((_,i)=>zp.reduce((s,k)=>s+D[k].t[i],0)/zp.length))}
function zshow(U){const dev=U.map((v,i)=>v-ZAV[i]),ord=dev.map((v,i)=>i).sort((a,b)=>dev[b]-dev[a]),T=window.zT||ZTY[ord[0]];
const rec=ZR.filter(x=>!zp.includes(zk(x))&&!has("eat",x)).map(x=>({x,sim:100-5*Math.sqrt(x.t.reduce((s,v,i)=>s+(v-U[i])**2,0))+.15*(x.tot-70)})).sort((a,b)=>b.sim-a.sim).slice(0,5);
$("zres").hidden=false;
$("zres").innerHTML=`<h2>② あなたの好みは…</h2><p class="ztype">${T[0]}</p><p class="zdesc">${T[1]}</p><div class="zrd">${zradar(U)}<div class="zleg"><span><i></i>あなたの好み</span><span><i class="g"></i>全体の平均</span><span>特に高い観点：${ord.slice(0,2).map(i=>AX[i]).join("・")}</span></div></div><h2 style="margin-top:14px">③ 次に食べたいおすすめ（未食べの中から）</h2>`+rec.map(({x,sim})=>{const why=ord.slice(0,2).filter(i=>x.t[i]>=U[i]-2).map(i=>AX[i]);return`<div class="zrec"><div class="ph" style="background:${bg(x.c)}">${pic(x)}</div><div><h3>${x.n}</h3><p>${[x.s,x.a!=="未設定"?x.a:""].filter(Boolean).join("・")}・${x.tot}点</p><p>${why.length?why.join("・")+"が好みに近い":"全体の傾向が近い"}</p><button class="zw" data-w="${zk(x)}" aria-pressed="${has("want",x)}">🍴 行きたい</button></div><div class="zm">${Math.max(0,Math.min(99,Math.round(sim)))}%<small>一致度</small></div></div>`}).join("")+`<button class="zgo zsub" id="zagain">選び直す</button>`;
$("zagain").onclick=()=>{zp=[];$("zres").hidden=true;zchosen();zlist();scrollTo(0,0)};$("zres").scrollIntoView({behavior:"smooth"})}
$("zres").addEventListener("click",e=>{const b=e.target.closest("[data-w]");if(!b)return;flip("want",D[b.dataset.w]);b.setAttribute("aria-pressed",has("want",D[b.dataset.w]));bar();grid()});
$("zlist").addEventListener("click",e=>{const b=e.target.closest(".zit");if(!b)return;const i=+b.dataset.i,p=zp.indexOf(i);if(p>=0)zp.splice(p,1);else if(zp.length<5)zp.push(i);zchosen();zlist()});
$("zchosen").addEventListener("click",e=>{const b=e.target.closest("[data-x]");if(!b)return;zp=zp.filter(i=>i!==+b.dataset.x);zchosen();zlist()});
$("zq").addEventListener("input",e=>{zQ=e.target.value.trim().toLowerCase();zlist()});
$("zauto").onclick=()=>{zp=ZR.filter(x=>has("eat",x)).sort((a,b)=>b.tot-a.tot).slice(0,5).map(zk);zchosen();zlist()};
$("zgo").onclick=zrun;
$("tabs").addEventListener("click",e=>{const b=e.target.closest("[data-tab]");if(!b)return;document.body.dataset.tab=b.dataset.tab;$("tabs").querySelectorAll("button").forEach(y=>y.setAttribute("aria-pressed",y===b));if(b.dataset.tab==="quiz"){zchosen();zlist()}else{bar();grid()}scrollTo(0,0)});
zchosen();zlist();
