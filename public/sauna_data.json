.cm{margin:8px 0 0;font-size:14px}
.close{font:inherit;font-weight:700;margin-top:16px;width:100%;padding:10px;border-radius:99px;border:none;background:var(--ink);color:var(--bg);cursor:pointer}
.ph img.photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.own{display:flex;gap:8px;margin-top:14px}.own .pick,.own .del{flex:1;text-align:center;font:inherit;font-weight:700;font-size:14px;padding:9px;border-radius:99px;border:1.5px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
