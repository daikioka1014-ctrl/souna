body{background:radial-gradient(circle at 8% -8%,#fff0d6 0,transparent 38%),radial-gradient(circle at 100% 2%,#fde6e1 0,transparent 32%),var(--bg);background-attachment:fixed}
.logo svg{transition:transform .4s}.logo:hover svg{transform:rotate(-8deg) scale(1.12)}
.sl{position:relative;aspect-ratio:5/2;border-radius:22px;overflow:hidden;box-shadow:0 8px 24px rgba(74,62,61,.14);background:var(--surface);touch-action:pan-y}
.slide{all:unset;box-sizing:border-box;position:absolute;inset:0;cursor:pointer;opacity:0;transition:opacity .9s;overflow:hidden}.slide.on{opacity:1;z-index:1}.slide:focus-visible{outline:3px solid #fff;outline-offset:-6px}
.slide .photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.slide.on .photo{animation:kb 7s ease-out both}
.slide>svg{position:absolute;left:50%;top:40%;width:26%;transform:translate(-50%,-50%)}
.shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(40,28,24,.74),rgba(40,28,24,0) 58%)}
.cap{position:absolute;left:clamp(16px,3vw,36px);right:16px;bottom:clamp(14px,3vw,30px);color:#fff;display:grid;gap:2px;text-align:left}
