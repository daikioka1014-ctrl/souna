let map,cl,um,UL=null,libs=false;
function add(tag,url,cb){const e=document.createElement(tag);if(tag==="link"){e.rel="stylesheet";e.href=url}else{e.src=url;e.onload=()=>cb();e.onerror=()=>cb(1)}document.head.appendChild(e);if(tag==="link")cb()}
function load(cb){if(window.L&&L.markerClusterGroup)return cb();const B="https://cdnjs.cloudflare.com/ajax/libs/";add("link",B+"leaflet/1.9.4/leaflet.min.css",()=>{});add("link",B+"leaflet.markercluster/1.5.3/MarkerCluster.css",()=>{});add("link",B+"leaflet.markercluster/1.5.3/MarkerCluster.Default.css",()=>{});
add("script",B+"leaflet/1.9.4/leaflet.min.js",e=>{if(e)return cb(1);add("script",B+"leaflet.markercluster/1.5.3/leaflet.markercluster.min.js",cb)})}
