const R2=D.filter(x=>!x.u);$("ronstats").innerHTML=`<div class="ig">${AX.map((a,i)=>{const b=R2.reduce((m,x)=>x.t[i]>m.t[i]?x:m,R2[0]),av=R2.reduce((s,x)=>s+x.t[i],0)/R2.length;return`<div class="ic"><span>${a}の最高点</span><b>${b.t[i]}<small>点</small></b><a href="#" data-open data-i="${D.indexOf(b)}">${b.n}</a><i>全体の平均 ${av.toFixed(1)}点</i></div>`}).join("")}</div>`;
