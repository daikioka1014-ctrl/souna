<script>
const AX=["味","見た目","バランス","素材感","意外性"];
const D=[{n:"ゆりねソフト",s:"コロッケリリー（真狩）",a:"北海道",c:"#f2e3c4",t:[14, 12, 10, 16, 16],m:"ゆりねの甘さは感じるが、ミルクとの調和はいまいち。後味に粉っぽさが少し残る。"},
{n:"わさびソフト",s:"道の駅　忠類",a:"北海道",c:"#b7d98b",t:[7, 12, 8, 20, 20],m:"まずい。バニラの味をほとんど感じないうちにわさびが香る。ソフトクリームには合わない。ただここまでわさびの味を出して商品化した勇気は素晴らしい。"},
{n:"山椒ソフト",s:"35stock 札幌市北区",a:"北海道",c:"#a9c98a",t:[15, 17, 10, 5, 12],m:""},
{n:"熊笹ソフト",s:"ぐるっとパノラマ美幌峠",a:"北海道",c:"#a8c98a",t:[15, 12, 12, 16, 14],m:"熊笹というチョイスはばっちり。味は抹茶のような感じ。普通においしかった。"},
{n:"ソフトクリーム（コープはまなか）",s:"コープはまなか",a:"北海道",c:"#fff4d6",t:[19, 12, 12, 12, 12],m:"ハーゲンダッツの牛乳使用。濃厚な牛乳を使っているので味も濃い。ミルクソフトの最高点かもしれない。"},
{n:"ダージリンソフト",s:"ニセコ ヴィラ・ルピシア",a:"北海道",c:"#d9a96a",t:[15, 15, 12, 18, 10],m:"めちゃくちゃダージリン味。紅茶好きならいいが、そうでない人は美味しく感じないかも。あと少し渋みが出てしまっているのは残念。"},
{n:"ラワンぶきソフト",s:"あしょろ銀河ホール21",a:"北海道",c:"#b4d28a",t:[17, 11, 12, 15, 15],m:"ラワンぶきの味はよくわからないが、ラワンぶきのジャムは甘くてソフトクリームに合う。そして驚くべきはラワンぶき関係なく、ミルクのソフトクリーム部分がめちゃくちゃ美味い。"},
{n:"プリンソフト",s:"十勝トテッポ工房",a:"北海道",c:"#f3d98b",t:[12, 11, 11, 9, 4],m:""},
{n:"オイスターモカソフト",s:"厚岸コンキリエ",a:"北海道",c:"#a98c7a",t:[14, 13, 14, 10, 9],m:""},
{n:"もくもくD51ソフト",s:"道の駅あびら",a:"北海道",c:"#e4e4ea",t:[12, 12, 10, 12, 10],m:""},
{n:"タイムズスクエアソフト",s:"札幌 タイムズスクエア",a:"北海道",c:"#fff4d6",t:[16, 13, 17, 14, 14],m:"あんことソフトクリームなので、間違いない美味しさ。"},
{n:"インカのめざめバターソフト",s:"新千歳空港 十勝バレー",a:"北海道",c:"#f3d27a",t:[16, 12, 14, 16, 13],m:"じゃがいもというよりはさつまいもソフトっぽい甘み。インカのめざめ使用がちゃんとわかる美味しいソフトクリームだった。"},
{n:"赤しそソフト",s:"とうや水の駅",a:"北海道",c:"#c0396b",t:[9, 10, 5, 19, 19],m:""},
{n:"プリンソフト",s:"JB",a:"北海道",c:"#f3d98b",t:[12, 18, 10, 10, 10],m:""},
{n:"リキュールソフトクリーム",s:"すすきのミルク村",a:"北海道",c:"#d9b9a0",t:[11, 12, 12, 12, 12],m:""},
{n:"ラベンダーソフト",s:"ファーム富田",a:"北海道",c:"#c3a6e0",t:[12, 14, 14, 17, 15],m:"ラベンダーの匂いが強く、苦手な人もいるかもしれない。全体的にはよくまとまってる印象。"},
{n:"みそぎ塩ソフト",s:"道の駅木古内",a:"北海道",c:"#f4f1e4",t:[16, 15, 17, 15, 15],m:"塩ソフトは数多くあるが、塩のソースのようなものがたくさんかかっていて、味も美味しい。"},
{n:"ハマナスソフト",s:"石狩ビジターセンター",a:"北海道",c:"#e87aa0",t:[13, 12, 12, 10, 16],m:""},
{n:"抹茶ソフト",s:"三井アウトレットパーク北広島",a:"北海道",c:"#8fb85e",t:[14, 10, 12, 17, 1],m:"めっちゃ濃い抹茶ソフト。"},
{n:"雪塩ソフトクリーム",s:"宮古島雪塩ミュージアム",a:"沖縄",c:"#eef4f8",t:[15, 12, 15, 13, 10],m:"塩加減が良い。自分で備え付けの色々な味の塩をかけて食べることを推奨している。あんまりかけないほうが美味しい。"},
{n:"ミルキーソフト",s:"マクドナルド",a:"北海道",c:"#fff7ee",t:[10, 12, 11, 12, 12],m:""},
{n:"洋梨ソフト",s:"JB",a:"北海道",c:"#d9e6a0",t:[13, 16, 11, 12, 12],m:""},
{n:"タリーズソフト",s:"日比谷公園タリーズ",a:"東京",c:"#d0b08a",t:[12, 12, 10, 12, 2],m:""},
{n:"ピスタチオソフト",s:"丸井今井 BABBI",a:"北海道",c:"#aac47a",t:[14, 12, 15, 12, 8],m:""},
{n:"アルパカソフト",s:"えこりん村 牧場のカフェ",a:"北海道",c:"#fff6e6",t:[10, 16, 18, 9, 5],m:"見た目が可愛く、コーンの包装紙にもアルパカが印刷されており手が込んでいる印象。ソフト自体が固めに作られているため溶けにくく食べやすかった。"},
{n:"かぼちゃソフト",s:"道の駅 花ロード 恵庭",a:"北海道",c:"#f0a844",t:[9, 8, 10, 1, 3],m:"リニューアルしたかぼちゃソフト。最低の出来。"},
{n:"イカスミソフト",s:"函館朝市",a:"北海道",c:"#4a4a55",t:[9, 10, 9, 9, 13],m:""},
{n:"極上牛乳ソフト",s:"新千歳空港 きのとや",a:"北海道",c:"#fff6e6",t:[16, 13, 10, 13, 5],m:"新千歳空港ソフトクリーム総選挙で第1位を獲得と聞いて期待していたが、期待を上回ることはなかった。確かに美味しいが、セイコーマートのソフトクリームの上位互換といったところ。クリームが固め。"},
{n:"コーヒー牛乳ソフト",s:"雪印パーラー",a:"北海道",c:"#b88f6a",t:[18, 10, 16, 15, 12],m:"コーヒー牛乳のソフトクリームそのままの味。とてもおいしい。"},
{n:"生ちちソフト",s:"登別温泉街",a:"北海道",c:"#fff8e8",t:[11, 10, 10, 12, 1],m:""},
{n:"ソフトクリーム（バルサミコ酢）",s:"",a:"北海道",c:"#6b4a3f",t:[12, 9, 12, 12, 14],m:""},
{n:"カフェラテソフト",s:"大丸オニヤンマコーヒー",a:"北海道",c:"#c8a98a",t:[14, 15, 15, 12, 5],m:""},
{n:"トマトソフト",s:"余湖農園",a:"北海道",c:"#e8604a",t:[13, 8, 11, 14, 12],m:"素材感が強いことは評価できるが、ミルクとの調和がとれていない。色も汚いので、もう少し色をつけつつ、ミルク感を強めてマイルドにした方が万人受けするだろう。"},
{n:"読谷紫芋ソフト",s:"帯広 クランベリー本店",a:"北海道",c:"#b08ad0",t:[14, 11, 16, 17, 11],m:"安くて美味しいです。"},
{n:"かんろソフト",s:"道の駅 あびらD51ステーション",a:"北海道",c:"#d8b077",t:[15, 15, 12, 16, 16],m:"こちらは夏季の一時期のみ提供している様子。良い意味でかんろの青臭さはあるが、爽やかな味わい。安平はソフトクリームを期間限定でよく変更していて、そのどれもが美味しいので、ド田舎の割に頑張っている。ちなみに私の地元である。"},
{n:"クマゴロンソフト（塩味）",s:"新千歳空港 siretoco sky sweets",a:"北海道",c:"#e8ecef",t:[14, 14, 15, 15, 11],m:"見た目だけのソフトクリーム。普通の味。"},
{n:"抹茶ソフト",s:"BARNES（バーンズ）",a:"北海道",c:"#a9c97a",t:[18, 15, 18, 15, 5],m:"北海道最強のソフトクリーム店BARNES。月替わりでソフトクリームは変わるが何食べても美味いのでぜひ行ってほしい。カルピジャーニでふわふわのソフトクリームは最高です。"},
{n:"ソフトクリーム（幸せの生ソフト）",s:"幸せの生ソフト（苫小牧）",a:"北海道",c:"#fff4d6",t:[12, 12, 10, 12, 1],m:""},
{n:"ブーケソフト",s:"ガーデンフェスタ キッチンカー（トルネードなんちゃら）",a:"北海道",c:"#f4a6c4",t:[2, 11, 2, 12, 10],m:"エディブルフラワーの量が合ってない。ソフトがミックスを使っていて、全くこだわりを感じない。食べ放題のソフトに雑草を乗せたような味。"},
{n:"パイナップルソフト",s:"那覇空港ベイカーズキッチン",a:"沖縄",c:"#f6d95a",t:[14, 14, 13, 14, 14],m:"パイナップルの味もしつつミルク感もしっかりあって良いソフト。"},
{n:"ソフトクリーム（ましゅれ）",s:"ましゅれ（長沼）",a:"北海道",c:"#fff4d6",t:[12, 12, 10, 12, 6],m:""},
{n:"はちみつソフト",s:"登別",a:"北海道",c:"#f0c453",t:[12, 12, 12, 14, 12],m:""},
{n:"芝桜ソフト",s:"ひがしもこと芝櫻公園",a:"北海道",c:"#f4a6cf",t:[13, 12, 13, 10, 11],m:""},
{n:"バタフライピーソフト",s:"&amp;アールグレイ",a:"未設定",c:"#8fa8ee",t:[12, 18, 12, 17, 15],m:"色が派手でいい。味も悪くはないが、香りが強めなので苦手な人は苦手かも。"},
{n:"塩レモンソフト",s:"JB",a:"北海道",c:"#f1ec9a",t:[14, 16, 11, 14, 12],m:"見た目全振りのソフト。味は普通。"},
{n:"チョコレートゴールデン",s:"北広島アウトレットパーク GODIVA",a:"北海道",c:"#7a4a32",t:[13, 13, 12, 10, 9],m:""},
{n:"りんごソフト",s:"道の駅ななえ",a:"北海道",c:"#e9d27a",t:[13, 12, 9, 14, 10],m:""},
{n:"つつじソフト",s:"福井県 道の駅西山",a:"福井",c:"#f27aa6",t:[11, 11, 12, 9, 16],m:""},
{n:"うずらんソフト",s:"みたら室蘭",a:"北海道",c:"#f0e0b8",t:[17, 12, 14, 12, 12],m:"普通のミルクのソフトクリームともたまごソフトとも違うが、明確にコクの深さを感じる美味しいソフトクリーム。"},
{n:"スウェーデンMIXソフト",s:"道の駅当別",a:"北海道",c:"#f1ddc0",t:[18, 18, 18, 10, 12],m:"見た目、味ともに高水準。当別という片田舎でこのような素晴らしいソフトクリームが生まれてことに驚いた。"},
{n:"陣太鼓ソフト",s:"熊本駅",a:"熊本",c:"#c49a6c",t:[18, 10, 18, 15, 12],m:"あんことソフトクリームなので、間違いない美味しさ。熊本銘菓の陣太鼓がめちゃくちゃ練りこまれていて美味い。"},
{n:"ソフトクリーム（山中牧場）",s:"山中牧場（赤井川村）",a:"北海道",c:"#fff4d6",t:[15, 10, 10, 10, 1],m:""},
{n:"デコポンソフト",s:"熊本城城彩園",a:"熊本",c:"#ffb347",t:[14, 16, 11, 12, 15],m:"デコポンの香りは感じるが、柑橘系ソフトクリームは難しいなと感じる。酸味をどこまで活かせるかと水分量の調整の結果、素材感が抑えられてしまっているように思う。"},
{n:"ナイアガラソフト",s:"余市ワイナリー カフェ&amp;ベーカリー",a:"北海道",c:"#e6efb8",t:[19, 12, 18, 18, 14],m:"まるでナイアガラをそのまま食べているかのように錯覚するほど、芳醇な香りが突き抜ける。果肉を練りこんでいるようで、シャキシャキときた食感も楽しめる。完成された一品と言えるだろう。"},
{n:"じんたソフト",s:"美ら海水族館内",a:"沖縄",c:"#8ed0e8",t:[10, 13, 10, 10, 12],m:"ラムネ味。"},
{n:"ブルーベリーソフト",s:"とうや水の駅",a:"北海道",c:"#6a6fb0",t:[14, 12, 12, 8, 8],m:""},
{n:"ひまわりソフト",s:"道の駅 雨竜町",a:"北海道",c:"#f2c94c",t:[10, 9, 9, 2, 9],m:"ただのソフトクリームにひまわりの種を乗せただけのもの。拍子抜けもいいところ。色つけるだけでも、だいぶ良くなると思うが。作り手の熱意を感じない残念な一品。"},
{n:"ローズソフト",s:"秩父別",a:"北海道",c:"#f08fb0",t:[9, 10, 8, 16, 12],m:""},
{n:"ソフトクリーム（いちえ）",s:"いちえ（恵庭）",a:"北海道",c:"#fff4d6",t:[12, 10, 5, 2, 1],m:""},
{n:"ソフトクリーム（地球のアイス）",s:"地球のアイス",a:"北海道",c:"#fff4d6",t:[11, 12, 10, 12, 1],m:""},
{n:"炭コロソフト",s:"道の駅 夕張メロード",a:"北海道",c:"#6d6d72",t:[14, 15, 16, 10, 13],m:"炭鉱の町として栄えていたが、財政破綻全国でも有名な夕張のソフトクリーム。コーヒー氷がトッピングされていて、炭鉱を表現している。アイディアも見た目も悪くない。"},
{n:"ソフトクリーム（ナイタイテラス）",s:"士幌ナイタイテラス",a:"北海道",c:"#fff4d6",t:[12, 12, 10, 12, 1],m:"ミルク感強め。"},
{n:"昆布ソフト",s:"北海道昆布館 七飯町",a:"北海道",c:"#6f8f6a",t:[4, 12, 9, 20, 19],m:"一口目からわかる。不味い。昆布の出汁がよく効いている。しかし、素材の味を最大限に活かした素晴らしい一品と言える。"},
{n:"ほうじ茶ソフト",s:"ニセコ ヴィラ・ルピシア",a:"北海道",c:"#c99a68",t:[13, 12, 14, 20, 10],m:"ちょっと苦いかな。もう少しほうじ茶を抑えてミルクを出したほうが美味しいとは思う。ただモチーフが自社の「鬼の焙煎ほうじ茶」であると思うから、素材感をフルに出そうとした結果だと思うので、個人的に評価は高い。"},
{n:"酒粕ソフト",s:"高砂酒造 旭川",a:"北海道",c:"#f2e6d0",t:[15, 10, 15, 12, 14],m:"酒粕ソフトということだが、それほどクセはなく食べやすい。個人的にはショートケーキのような甘さを感じた。"},
{n:"花蜜ソフト",s:"小樽 ナチュラルハニー",a:"北海道",c:"#f6c453",t:[12, 18, 12, 10, 12],m:"バニラに蜂蜜のため、相性○味も良い。花も酸味があるため、存在感はあるし、味のアクセントになっている。ただ価格が600円超えで高価格なので、その価値があるかは微妙。"},
{n:"いちごソフト",s:"道の駅豊浦",a:"北海道",c:"#f6a1b8",t:[12, 11, 11, 2, 5],m:"いちごが乗っているだけ。工夫が足りない。見た目ももう少し改良の余地はありそうだが。"},
{n:"大手饅頭ソフト",s:"倉敷 大手饅頭伊部屋",a:"岡山",c:"#c8a07a",t:[14, 12, 14, 14, 12],m:"あんこのソフトで美味しかった。以上。"},
{n:"きなごろもソフト",s:"帯広 柳月",a:"北海道",c:"#d9b98a",t:[16, 14, 16, 12, 6],m:""},
{n:"そばソフト",s:"新得 そばの館",a:"北海道",c:"#b9a58d",t:[15, 15, 15, 12, 15],m:"そばの味はほとんどしないが、香ばしさは感じる。まぁまぁ美味しい。"},
{n:"えびすかぼちゃソフト",s:"花ロード恵庭",a:"北海道",c:"#f2b24a",t:[16, 17, 17, 15, 10],m:"一口目からはわからないが食べ進めていくとかぼちゃの優しい甘みに気づく。ミルクとの調和は素晴らしく、後味も上品。見た目も綺麗なのも嬉しい。またワッフルコーンを使用しているのもポイントが高い。"},
{n:"サンクフロマージュ",s:"ドレモ・ルタオ",a:"北海道",c:"#fff3d6",t:[20, 16, 18, 15, 5],m:"味だけで言えば最高レベルのソフトクリーム。チーズケーキ好きにはぜひ食べてほしい。"},
{n:"青い池ソフト",s:"美瑛 青い池",a:"北海道",c:"#7cc0e8",t:[11, 14, 10, 10, 10],m:""},
{n:"ハスカップソフト",s:"道の駅ウトナイ湖",a:"北海道",c:"#8a5aa8",t:[14, 9, 14, 11, 13],m:"ハスカップ感はあまり感じなかった。もう少し素材の味を出すべき。色も中途半端。また、作る人がすごく下手。最低レベル。"},
{n:"ショコラソフト",s:"ピエールマルコリーニ",a:"北海道",c:"#6b4332",t:[16, 14, 13, 12, 1],m:""},
{n:"ホワイトチョコレートソフト",s:"ショコラティエマサール",a:"北海道",c:"#fdf3e0",t:[13, 12, 11, 12, 7],m:""},
{n:"三尺バナナソフト",s:"宮古島ユートピアファーム",a:"沖縄",c:"#f3dc6e",t:[16, 11, 14, 20, 16],m:"バナナの味が強いが、素材をふんだんに練りこんでいてこだわりも感じる。"},
{n:"スイートポテトソフト",s:"北広島 FAKE",a:"北海道",c:"#e6a95c",t:[12, 16, 0, 12, 14],m:""},
{n:"ほうじ茶ソフト",s:"帯広 柳月",a:"北海道",c:"#c99a68",t:[14, 12, 10, 11, 12],m:""},
{n:"ブロッコリーソフト",s:"道の駅 鐘のなるまち 秩父別",a:"北海道",c:"#8fbf6a",t:[13, 12, 18, 14, 20],m:"抹茶のような味わいだが、食べ進めているとブロッコリーの風味を感じる。爽やかながらも、独特の苦味があり、いい意味でブロッコリー臭さもある素晴らしい一品。"},
{n:"藻岩山展望台で食べたソフト",s:"藻岩山展望台",a:"北海道",c:"#fff4d6",t:[9, 12, 10, 12, 13],m:""},
{n:"ソフトクリーム（マザーズ）",s:"白老 マザーズ",a:"北海道",c:"#fff0b8",t:[14, 10, 10, 2, 1],m:"たまごソフトかと思いきや普通のソフトクリーム。"},
{n:"いちごミルクソフト",s:"北広島アウトレットパーク MILL PRESSO",a:"北海道",c:"#f8b6c8",t:[16, 15, 13, 12, 11],m:"いちごミルクって感じでそれだけ。"},
{n:"しいたけソフト",s:"きのこ王国（大滝村）",a:"北海道",c:"#b89a7c",t:[15, 10, 15, 14, 15],m:"しいたけのフレークみたいのがたくさんまぶされている。意外と美味いが、どうせなら生地に練りこんでほしい。かけるだけでしいたけソフトを名乗るのはおこがましい。"},
{n:"ダブルピュアソフト",s:"みるくsan",a:"北海道",c:"#f6e7b0",t:[14, 12, 12, 12, 4],m:"黄みかかっているソフトクリームは、西興部村の萩原牧場のものを使用しています。白っぽい方が帯広市の十勝加藤牧場のソフトクリーム"},
{n:"プレミア豆乳ソフト",s:"道の駅 あびらD51ステーション",a:"北海道",c:"#f5ecd8",t:[15, 12, 15, 15, 10],m:"美味しい豆乳ソフト。"},
{n:"カマンベールソフト",s:"レストランみやもと 早来",a:"北海道",c:"#fff0c4",t:[14, 12, 9, 20, 16],m:"そんなに美味しくはないが、チーズの味、匂いはしっかりと感じる。カマンベールが苦手な人はやめておいた方がいい。"},
{n:"でんすけスイカソフト",s:"道の駅とうま でんすけさんの家 当麻町",a:"北海道",c:"#f48a96",t:[14, 14, 16, 17, 14],m:"若干スイカの青臭さは感じるが、嫌いでない人ならばむしろ美味しいと感じるだろう。ミルクとの調和も取れており、及第点と言える。"},
{n:"美ら島松ゴールドパインプレミアムソフト",s:"美ら海水族館",a:"沖縄",c:"#f6cf4a",t:[12, 10, 12, 10, 12],m:""},
{n:"ブーケソフトフラワーフレーバー",s:"有楽町『NAKED FLOWERS CAFE ネイキッド フラワーズ カフェ』",a:"東京",c:"#f4a6c4",t:[10, 14, 8, 14, 14],m:"青バラ味。"},
{n:"ほうじ茶ソフト",s:"道の駅上士幌 THE SAND",a:"北海道",c:"#c99a68",t:[12, 12, 12, 12, 12],m:"",u:1},
{n:"ふらのぶどう果汁ソフト",s:"富良野ぶどう果汁工場",a:"北海道",c:"#b59bd6",t:[14, 14, 16, 14, 11],m:"ぶどう味のソフトクリーム。ほかに感想はない。"},
{n:"あんこソフト",s:"大丸札幌 あんこフェス 空色",a:"北海道",c:"#8a5b52",t:[15, 10, 14, 18, 12],m:"あんこのソフトだから上手い。ちょっと粉っぽかった。"},
{n:"アールグレイソフト",s:"&amp;アールグレイ",a:"未設定",c:"#b8a58f",t:[16, 15, 12, 15, 12],m:"アールグレイの香り強め。紅茶好きなら好きだと思う。"},
{n:"ドラゴンフルーツソフト",s:"宮古島 ユートピアファーム",a:"沖縄",c:"#f06aa8",t:[14, 12, 12, 18, 15],m:"ドラゴンフルーツ自体がそんなに味の強いものではないが、ちゃんとソフトクリームに落とし込んでいる。"},
{n:"醤油ソフト",s:"福岡空港 久原本家",a:"福岡",c:"#b8864e",t:[16, 10, 12, 18, 15],m:"醤油＋アイスはみたらし団子風の味になるとはよく言われるが、そのとおりの味。ただ醤油が強いのかミルク感が損なわれているので、バランスという点ではいまいち。"},
{n:"桜ソフト",s:"五稜郭タワー（花見期間限定商品）",a:"北海道",c:"#f8cfe0",t:[12, 12, 13, 10, 11],m:"桜の香りがほのかに香る。うすいピンク色の見た目も良い。ミルクとの調和はあと一歩というところ。桜の花びらをトッピングするなどの創意工夫が欲しいところ。"},
{n:"くりりんかぼちゃのソフトクリーム",s:"函館",a:"北海道",c:"#f2b24a",t:[12, 12, 12, 14, 10],m:""},
{n:"シマエナガソフト",s:"バードウォッチングカフェ（千歳）",a:"北海道",c:"#f3f6fa",t:[12, 16, 8, 10, 10],m:"普通のミルクソフト"},
{n:"ソフトクリーム（プロント）",s:"新千歳空港 プロント",a:"北海道",c:"#fff4d6",t:[15, 10, 15, 10, 2],m:"ミルク感が強いソフトクリーム。美味しかった。"},
{n:"プルーンソフト",s:"石狩市 佐藤水産",a:"北海道",c:"#8a5a8f",t:[11, 10, 12, 12, 14],m:""},
{n:"ピーマンソフト",s:"道の駅サラブレットロード新冠",a:"北海道",c:"#9cc96b",t:[16, 16, 18, 18, 20],m:"ピーマンの主張が強いかと思うだろうが、一切嫌味のないスッキリした味わい。しかし、ちゃんとピーマンの香りはするため、存在感は十分にある。ミルクとの調和も素晴らしい。"},
{n:"白い恋人ソフト",s:"新千歳空港お土産やさん",a:"北海道",c:"#fff6ec",t:[15, 12, 12, 10, 10],m:"白い恋人の味はあまりしない。甘めのソフトクリームという感じだった。"},
{n:"ソフトクリーム（ナマケモノカフェ）",s:"ナマケモノカフェ",a:"北海道",c:"#fff4d6",t:[10, 12, 10, 12, 1],m:""},
{n:"シャインマスカットソフト",s:"ウポポイ",a:"北海道",c:"#c5df8a",t:[12, 12, 10, 10, 10],m:""},
{n:"青リンゴソフト",s:"JB",a:"北海道",c:"#b9e08a",t:[12, 15, 11, 13, 12],m:""},
{n:"じゃがッキーソフト",s:"わかさいも本舗（洞爺）",a:"北海道",c:"#ecd28a",t:[14, 12, 14, 12, 16],m:"お菓子素材のソフトクリームだが、じゃがいも感もほのかに感じられて良い。"},
{n:"塩ソフト",s:"石狩市 佐藤水産",a:"北海道",c:"#eef2f4",t:[12, 10, 13, 13, 10],m:""},
{n:"ジンベエソフト",s:"海遊館",a:"大阪",c:"#7fb7e6",t:[12, 15, 13, 8, 10],m:"ラムネ味のソフトクリーム。味はいたって普通だがジンベエザメの模様をイメージした作りで悪くはないかな。"},
{n:"エスプレッソソフト",s:"大丸オニヤンマコーヒー",a:"北海道",c:"#7a5a45",t:[15, 14, 12, 13, 5],m:""},
{n:"ソフトクリーム",s:"江別ソフトクリーム工房",a:"北海道",c:"#fff4d6",t:[12, 12, 10, 12, 1],m:"油分多め。"},
{n:"ソフトクリーム（星野リゾート）",s:"星野リゾートのソフトクリーム",a:"北海道",c:"#fff4d6",t:[12, 12, 10, 12, 1],m:""},
{n:"クレミアソフト",s:"",a:"北海道",c:"#fff1d0",t:[14, 13, 15, 3, 1],m:"甘めのソフトクリーム。コーンがラングドシャで最後まで美味しい。ただ普通。"},
{n:"花はすソフト",s:"福井県",a:"福井",c:"#f5b8cf",t:[12, 12, 12, 12, 16],m:""},
{n:"ソイソフト",s:"豆鉄砲（恵庭）",a:"北海道",c:"#efe3c4",t:[12, 9, 12, 15, 10],m:""},
{n:"さくらんぼソフト",s:"",a:"未設定",c:"#e0556e",t:[12, 12, 12, 12, 12],m:"",u:1},
