map=L.map("map",{scrollWheelZoom:false}).setView([43.0,142.4],6);L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:18,attribution:"© OpenStreetMap contributors"}).addTo(map);cl=L.markerClusterGroup({maxClusterRadius:45});map.addLayer(cl);
