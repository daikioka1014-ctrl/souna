function swirl(c,w){return `<svg viewBox="0 0 100 130"><path d="M26 62h48L50 124z" fill="#d9a55b"/><path d="M34 70l22 40M46 66l16 34M58 64l8 14M30 80l30 36M66 66L40 118" stroke="#b5803a" stroke-width="2" opacity=".55"/><ellipse cx="50" cy="60" rx="30" ry="11" fill="${c}"/><ellipse cx="50" cy="46" rx="24" ry="10" fill="${c}"/><ellipse cx="50" cy="33" rx="17" ry="9" fill="${c}"/><path d="M50 8c7 5 4 12 0 17-4-5-7-12 0-17z" fill="${c}"/><g fill="none" stroke="#1b2a41" stroke-opacity=".14" stroke-width="2.4"><path d="M24 58c14 8 38 8 52 0"/><path d="M30 45c12 7 28 7 40 0"/><path d="M36 32c9 6 19 6 28 0"/></g></svg>`}
function bg(c){return `color-mix(in srgb,${c} 42%,var(--bg))`}
function radar(t){const cx=100,cy=100,R=70;const pt=(i,v)=>{const g=-Math.PI/2+i*2*Math.PI/5;return[cx+R*v/20*Math.cos(g),cy+R*v/20*Math.sin(g)]};
let g="";[5,10,15,20].forEach(l=>{g+=`<polygon points="${[0,1,2,3,4].map(i=>pt(i,l).join(",")).join(" ")}" fill="none" stroke="var(--line)" stroke-width="1.2"/>`});
[0,1,2,3,4].forEach(i=>{const p=pt(i,20);g+=`<line x1="${cx}" y1="${cy}" x2="${p[0]}" y2="${p[1]}" stroke="var(--line)"/>`});
const poly=t.map((v,i)=>pt(i,v).join(",")).join(" ");
let lb="";AX.forEach((a,i)=>{const g2=-Math.PI/2+i*2*Math.PI/5;const x=cx+(R+17)*Math.cos(g2),y=cy+(R+17)*Math.sin(g2)+4;lb+=`<text x="${x}" y="${y}" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--ink)">${a}</text>`});
return `<svg class="radar" viewBox="0 0 200 200" role="img" aria-label="5項目のレーダーチャート">${g}<polygon points="${poly}" fill="var(--accent)" fill-opacity=".3" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round"/>${lb}</svg>`}

let sort="-1",area="すべて";
const $=id=>document.getElementById(id);
const P=JSON.parse($("ph").textContent||"{}"),K=x=>x.n+"|"+x.s;
const pic=x=>P[K(x)]?`<img class="photo" src="${P[K(x)]}" alt="${x.n}" loading="lazy">`:swirl(x.c);
let OWN=false;(async()=>{try{const u=await claude.use("user");OWN=u?await u.isOwner():false}catch(e){}})();
let MY={want:[],eat:[]};try{const j=JSON.parse(localStorage.getItem("sc-mine")||"{}");MY.want=j.want||[];MY.eat=j.eat||[]}catch(e){}
const has=(t,x)=>MY[t].includes(K(x)),saveMy=()=>{try{localStorage.setItem("sc-mine",JSON.stringify(MY))}catch(e){}},flip=(t,x)=>{const k=K(x),i=MY[t].indexOf(k);if(i<0)MY[t].push(k);else MY[t].splice(i,1);if(t==="eat"&&i<0){const w=MY.want.indexOf(k);if(w>=0)MY.want.splice(w,1)}saveMy()};
let vw="c",lim=24,lastSig="";let mine="all",cols="4";try{const c=localStorage.getItem("sc-cols");if(c)cols=c}catch(e){}
$("logo").innerHTML=swirl("#fff6dd").replace(/^<svg[^>]*>|<\/svg>$/g,"");
$("n").textContent=D.length;
const R0=D.filter(x=>!x.u);$("avg").textContent=(R0.reduce((p,q)=>p+q.tot,0)/R0.length).toFixed(1);
$("max").textContent=Math.max(...R0.map(x=>x.tot));
const R=D.filter(x=>!x.u);D.forEach(x=>x.r=x.u?0:1+R.filter(y=>y.tot>x.tot).length);

function bar(){const cnt={};D.forEach(x=>cnt[x.a]=(cnt[x.a]||0)+1);const areas=["すべて",...Object.keys(cnt).sort((p,q)=>(p==="未設定")-(q==="未設定")||cnt[q]-cnt[p])];
$("bar").innerHTML=`<div class="r">`+[["-1","総合点順"],...AX.map((a,i)=>[String(i),a+"順"])].map(([k,l])=>`<button data-s="${k}" aria-pressed="${sort===k}">${l}</button>`).join("")+`</div><div class="r">`+areas.map(a=>`<button data-a="${a}" aria-pressed="${area===a}">${a}</button>`).join("")+`</div><div class="r">`+[["all","全部"],["want","🍴 行きたい"],["new","未食べ"],["eat","✅ 食べた"]].map(([k,l])=>`<button data-m="${k}" aria-pressed="${mine===k}">${l}</button>`).join("")+`<span class="prog">食べた ${D.filter(x=>has("eat",x)).length} / ${D.length}</span></div><div class="r cols"><span class="prog">スマホの列数</span>`+["2","3","4"].map(c=>`<button data-c="${c}" aria-pressed="${cols===c}">${c}列</button>`).join("")+`</div><div class="r"><span class="prog">表示</span><button data-v="c" aria-pressed="${vw==="c"}">カード</button><button data-v="l" aria-pressed="${vw==="l"}">リスト</button></div>`}
const CR={1:["#f5c34a","#a9741b"],2:["#d3d9e0","#7b8794"],3:["#dc9a62","#8a5a2e"]},crown=r=>`<svg class="crown" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 17.5 1.5 6.8l5.2 4.2L12 3l5.3 8 5.2-4.2-1 10.7z" fill="${CR[r][0]}" stroke="${CR[r][1]}" stroke-width="1.2" stroke-linejoin="round"/><rect x="3" y="18.8" width="18" height="3" rx="1" fill="${CR[r][0]}" stroke="${CR[r][1]}" stroke-width="1.2"/><circle cx="12" cy="13" r="1.6" fill="#fff" opacity=".85"/></svg>`;
const topAx=x=>x.u?"仮点":AX[x.t.indexOf(Math.max(...x.t))]+" "+Math.max(...x.t);
function tbl(V){return `<div class="tw"><table><thead><tr><th>順位</th><th>名前</th><th class="hs">店名・エリア</th>${AX.map(a=>`<th class="n hs">${a}</th>`).join("")}<th class="n">合計</th></tr></thead><tbody>${V.map(x=>{const sh=[x.s,x.a!=="未設定"?x.a:""].filter(Boolean).join("・");return`<tr data-open data-i="${D.indexOf(x)}" tabindex="0"><td class="rk${x.r&&x.r<4?" t3":""}">${x.u?"仮":x.r&&x.r<4?crown(x.r)+" "+x.r:x.r}</td><td><b>${x.n}</b>${has("eat",x)?" ✅":has("want",x)?" 🍴":""}<span class="sub ms">${sh}</span></td><td class="hs sub">${sh}</td>${x.t.map(v=>`<td class="n hs">${v}</td>`).join("")}<td class="n tt">${x.tot}</td></tr>`}).join("")}</tbody></table></div>`}
function grid(){let L=D.filter(x=>(area==="すべて"||x.a===area)&&(!Q||(x.n+x.s+x.m).toLowerCase().includes(Q))&&(mine==="all"||(mine==="want"&&has("want",x))||(mine==="eat"&&has("eat",x))||(mine==="new"&&!has("eat",x))));
L.sort((p,q)=>sort==="-1"?q.tot-p.tot:q.t[+sort]-p.t[+sort]||q.tot-p.tot);const sig=sort+area+mine+Q+vw;if(sig!==lastSig){lastSig=sig;lim=vw==="l"?20:24}const V=L.slice(0,lim);
$("grid").dataset.c=cols;$("grid").style.setProperty("--c",cols);$("grid").innerHTML=!L.length?`<p class="empty">該当するソフトクリームがありません</p>`:vw==="l"?tbl(V):V.map(x=>`<button class="card" data-open data-i="${D.indexOf(x)}"><div class="ph" style="background:${bg(x.c)}">${pic(x)}<span class="rank${!x.u&&x.r<4?" cr":""}">${x.u?"仮点":x.r<4?crown(x.r)+"<b>"+x.r+"</b>":x.r+"位"}</span>${has("eat",x)?`<span class="mk">✅ 食べた</span>`:has("want",x)?`<span class="mk w">🍴 行きたい</span>`:""}</div><div class="info"><span class="tag">${topAx(x)}</span><h3>${x.n}</h3><p>${[x.s,x.a].filter(Boolean).join("・")}</p><div class="score">${x.tot}<small>${x.u?"/100 仮点":"/100"}</small></div></div></button>`).join("");$("more").hidden=L.length<=lim;$("more").textContent=`もっと見る（残り${L.length-lim}件）`;$("grid").classList.toggle("lst",vw==="l")}
$("bar").addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;if(b.dataset.s)sort=b.dataset.s;if(b.dataset.a)area=b.dataset.a;if(b.dataset.m)mine=b.dataset.m;if(b.dataset.v)vw=b.dataset.v;if(b.dataset.c){cols=b.dataset.c;try{localStorage.setItem("sc-cols",cols)}catch(e){}}bar();grid()});
document.addEventListener("click",e=>{const b=e.target.closest("[data-open]");if(!b)return;e.preventDefault();const x=D[b.dataset.i];
$("dl").innerHTML=`<div class="ph" style="background:${bg(x.c)}">${pic(x)}</div><h2>${x.n}</h2><p class="meta">${[x.s,x.a].filter(Boolean).join("・")}</p><div class="total">${x.tot}<small> / 100点${x.u?"（仮点・順位対象外）":"（"+(x.r<4?crown(x.r)+" ":"")+x.r+"位）"}</small></div><div class="chart">${radar(x.t)}<div class="bars">${AX.map((a,i)=>`<div><span>${a}</span><i><b style="width:${x.t[i]*5}%"></b></i><span>${x.t[i]}</span></div>`).join("")}</div></div>${x.m?`<p class="cm">${x.m}</p>`:""}${OWN?`<div class="own"><label class="pick">写真を選ぶ<input type="file" accept="image/*" hidden data-k="${b.dataset.i}"></label>${P[K(x)]?`<button class="del" data-k="${b.dataset.i}">写真を削除</button>`:""}</div>`:""}<div class="mine" data-i="${b.dataset.i}"><button data-t="want" aria-pressed="${has("want",x)}">🍴 行きたい</button><button data-t="eat" aria-pressed="${has("eat",x)}">✅ 食べた</button></div><button class="close" onclick="dlg.close()">閉じる</button>`;
$("dlg").showModal()});
$("dlg").addEventListener("click",e=>{if(e.target===$("dlg"))$("dlg").close()});
$("dl").addEventListener("click",e=>{const b=e.target.closest(".mine button");if(!b)return;const x=D[b.parentNode.dataset.i];flip(b.dataset.t,x);b.parentNode.querySelectorAll("button").forEach(y=>y.setAttribute("aria-pressed",has(y.dataset.t,x)));bar();grid()});
let Q="";$("q").addEventListener("input",e=>{Q=e.target.value.trim().toLowerCase();grid()});bar();grid();
function shrink(f){return new Promise((ok,ng)=>{const im=new Image(),u=URL.createObjectURL(f);im.onload=()=>{const r=Math.min(1,800/Math.max(im.width,im.height)),c=document.createElement("canvas");c.width=Math.round(im.width*r);c.height=Math.round(im.height*r);c.getContext("2d").drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);ok(c.toDataURL("image/jpeg",.8))};im.onerror=ng;im.src=u})}
async function save(){const a=await claude.use("artifact");if(!a){alert("保存できません");return}
const d=document.documentElement.cloneNode(true);d.querySelector("#ph").textContent=JSON.stringify(P);
["logo","bar","grid","dl"].forEach(i=>d.querySelector("#"+i).innerHTML="");["n","avg","max"].forEach(i=>d.querySelector("#"+i).textContent="0");d.querySelector("#dlg").removeAttribute("open");
try{await a.publish("<!DOCTYPE html>\n"+d.outerHTML)}catch(e){if(e.code!=="conflict")alert("保存できませんでした（"+(e.code||"error")+"）")}}
$("dl").addEventListener("change",async e=>{const i=e.target;if(!i.matches("input[type=file]")||!i.files[0])return;const x=D[i.dataset.k];try{P[K(x)]=await shrink(i.files[0])}catch(_){alert("画像を読み込めませんでした");return}await save()});
$("dl").addEventListener("click",async e=>{const b=e.target.closest(".del");if(!b)return;delete P[K(D[b.dataset.k])];await save()});
